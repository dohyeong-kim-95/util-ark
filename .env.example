# Public build-time identifiers, not credentials. Never commit real values —
# production reads these from repository variables. Leaving one empty is a
# supported state that npm test checks.

# Add these only after AdSense approval.
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT=

# The value Naver Webmaster Tools issues for meta-tag ownership verification.
PUBLIC_NAVER_SITE_VERIFICATION=
