---
import { conversions } from '../data/conversions';
import { guidesForTool } from '../data/guides';
import { tools, type ToolDefinition } from '../data/tools';
import type { Locale } from '../i18n/ui';
import { ui } from '../i18n/ui';
import AdSlot from './AdSlot.astro';
import ToolCard from './ToolCard.astro';
import ImageConverter from './tools/ImageConverter.astro';
import Ladder from './tools/Ladder.astro';
import MergePdf from './tools/MergePdf.astro';
import WordCounter from './tools/WordCounter.astro';

interface Props {
  tool: ToolDefinition;
  locale: Locale;
}

const { tool, locale } = Astro.props;
const copy = tool.copy[locale];
const components = {
  'image-converter': ImageConverter,
  'word-counter': WordCounter,
  'merge-pdf': MergePdf,
  ladder: Ladder,
};
const InteractiveTool = components[tool.slug];
// Without this a tool page is a dead end: the only ways out were the breadcrumb
// and the footer. Sites that rank for these keywords carry the whole tool list
// on every tool page, which is how the pages pass signal to each other.
const otherTools = tools.filter((entry) => entry.slug !== tool.slug);
// A tool page has to stay usable at a glance, so the depth lives in guides and
// the page points at them instead of growing.
const relatedGuides = guidesForTool(tool.slug);
// The converter is the hub for the directed-pair pages: it holds the general
// "image converter" query while each pair holds its own, and the hub is how
// they are found.
const pairPages = tool.slug === 'image-converter' ? conversions : [];
---

<div class="shell tool-page">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={`/${locale}/`}>{ui[locale].common.breadcrumbHome}</a>
    <span aria-hidden="true">/</span>
    <a href={`/${locale}/#tools`}>{ui[locale].common.breadcrumbTools}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{copy.name}</span>
  </nav>

  <header class="tool-hero" style={`--tool-accent:${tool.accent}`}>
    <span class="privacy-pill"><span aria-hidden="true">●</span>{ui[locale].common.localBadge}</span>
    <h1>{copy.name}</h1>
    <p>{copy.short}</p>
  </header>

  <section class="interactive-panel" aria-label={copy.name}>
    <InteractiveTool locale={locale} />
  </section>

  <AdSlot locale={locale} />

  <div class="content-grid">
    <article class="prose">
      {copy.intro.map((paragraph) => <p>{paragraph}</p>)}

      <h2>{ui[locale].common.howItWorks}</h2>
      <ol>
        {copy.steps.map((step) => <li>{step}</li>)}
      </ol>

      <h2>{ui[locale].common.faq}</h2>
      <div class="faq-list">
        {copy.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </article>

    <aside class="trust-card">
      <span aria-hidden="true">◎</span>
      <h2>{ui[locale].home.privacyTitle}</h2>
      <p>{ui[locale].home.privacyBody}</p>
      <a href={`/${locale}/privacy/`}>{ui[locale].nav.privacy} →</a>
    </aside>
  </div>

  {pairPages.length > 0 && (
    <section class="more-tools" aria-labelledby="pair-pages-heading">
      <h2 id="pair-pages-heading">{ui[locale].common.otherConversions}</h2>
      <ul class="conversion-links">
        {pairPages.map((entry) => (
          <li style={`--tool-accent:${entry.accent}`}>
            <a href={`/${locale}/${entry.slug}/`}>{entry.copy[locale].name}</a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {relatedGuides.length > 0 && (
    <section class="related-guides" aria-labelledby="related-guides-heading">
      <h2 id="related-guides-heading">{ui[locale].common.relatedGuides}</h2>
      <ul>
        {relatedGuides.map((guide) => (
          <li>
            <a href={`/${locale}/guides/${guide.slug}/`}>{guide.copy[locale].title}</a>
            <p>{guide.copy[locale].description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="more-tools" aria-labelledby="more-tools-heading">
    <h2 id="more-tools-heading">{ui[locale].common.moreTools}</h2>
    <div class="tool-grid">
      {otherTools.map((entry) => <ToolCard tool={entry} locale={locale} />)}
    </div>
  </section>
</div>
