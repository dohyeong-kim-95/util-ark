---
import { MIME, type ImageFormat } from '../../data/conversions';
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
  /** Preset a directed pair so a conversion page opens ready to run. */
  from?: ImageFormat;
  to?: ImageFormat;
}

const { locale, from, to } = Astro.props;
const accept = from ? MIME[from] : 'image/jpeg,image/png,image/webp';
const target = to ? MIME[to] : 'image/webp';
// PNG is lossless, so a quality slider on a PNG target would do nothing.
const showQuality = to !== 'png';
const sourceHint = from ? from.toUpperCase() : 'JPG, PNG, WebP';
const labels = locale === 'ko'
  ? {
      pick: '이미지 선택',
      hint: `${sourceHint} · 여러 장 선택 가능 (두 장 이상이면 ZIP 하나로 내려받기)`,
      format: '저장 형식',
      quality: '화질',
      convert: '변환하고 내려받기',
      empty: '먼저 이미지를 선택해주세요.',
      working: '변환 중…',
      done: '개 파일을 변환했습니다.',
      failed: '변환하지 못했습니다.',
      failedFiles: '변환하지 못한 파일:',
      webpUnsupported: '이 브라우저는 WebP로 저장할 수 없어 JPG로 저장합니다.',
      remove: '삭제',
    }
  : {
      pick: 'Choose images',
      hint: `${sourceHint} · multiple files supported (two or more arrive as one ZIP)`,
      format: 'Output format',
      quality: 'Quality',
      convert: 'Convert & download',
      empty: 'Choose at least one image first.',
      working: 'Converting…',
      done: ' files converted.',
      failed: 'The images could not be converted.',
      failedFiles: 'Could not convert:',
      webpUnsupported: 'This browser cannot save WebP, so the files are saved as JPG.',
      remove: 'Remove',
    };
---

<div
  class="converter-tool"
  data-empty={labels.empty}
  data-working={labels.working}
  data-done={labels.done}
  data-failed={labels.failed}
  data-failed-files={labels.failedFiles}
  data-webp-unsupported={labels.webpUnsupported}
  data-remove={labels.remove}
>
  <label class="drop-zone">
    <input type="file" accept={accept} multiple />
    <strong>{labels.pick}</strong>
    <span>{labels.hint}</span>
  </label>

  <div class="file-list" aria-live="polite"></div>

  <div class="option-grid">
    <label>
      <span>{labels.format}</span>
      <select data-option="format">
        <option value="image/webp" selected={target === 'image/webp'}>WebP</option>
        <option value="image/jpeg" selected={target === 'image/jpeg'}>JPG</option>
        <option value="image/png" selected={target === 'image/png'}>PNG</option>
      </select>
    </label>
    {showQuality && (
      <label>
        <span>{labels.quality}: <output>85%</output></span>
        <input data-option="quality" type="range" min="40" max="100" value="85" step="1" />
      </label>
    )}
  </div>

  <div class="tool-actions">
    <button type="button" class="primary" data-action="convert">{labels.convert}</button>
    <span class="action-status" role="status"></span>
  </div>
</div>

<script>
  import { closeImage, decodeImage, downloadBlob } from '../../lib/browser-file';
  import { canEncodeWebp, encodeCanvas, extensionFor } from '../../lib/canvas-encode';

  const root = document.querySelector<HTMLElement>('.converter-tool');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('input[type="file"]');
    const list = root.querySelector<HTMLElement>('.file-list');
    const quality = root.querySelector<HTMLInputElement>('[data-option="quality"]');
    const qualityOutput = root.querySelector<HTMLOutputElement>('output');
    const format = root.querySelector<HTMLSelectElement>('[data-option="format"]');
    const status = root.querySelector<HTMLElement>('.action-status');
    let files: File[] = [];

    // Safari and every iOS browser cannot write WebP. Say so before anything
    // is picked, and switch to JPG, instead of revealing it after the download.
    const webpWritable = canEncodeWebp();
    if (format && !webpWritable) {
      if (format.value === 'image/webp') format.value = 'image/jpeg';
      const webpOption = format.querySelector<HTMLOptionElement>('option[value="image/webp"]');
      if (webpOption) webpOption.disabled = true;
      if (status) status.textContent = root.dataset.webpUnsupported ?? '';
    }

    const formatBytes = (bytes: number) => {
      if (bytes < 1024) return `${bytes} B`;
      if (bytes < 1024 ** 2) return `${(bytes / 1024).toFixed(1)} KB`;
      return `${(bytes / 1024 ** 2).toFixed(1)} MB`;
    };
    const render = () => {
      if (!list) return;
      list.replaceChildren();
      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'file-row';
        const info = document.createElement('span');
        const name = document.createElement('strong');
        name.textContent = file.name;
        const size = document.createElement('small');
        size.textContent = formatBytes(file.size);
        info.append(name, size);
        const remove = document.createElement('button');
        remove.type = 'button';
        remove.className = 'icon-button';
        remove.textContent = '×';
        remove.setAttribute('aria-label', `${root.dataset.remove}: ${file.name}`);
        remove.addEventListener('click', () => {
          files.splice(index, 1);
          render();
        });
        row.append(info, remove);
        list.append(row);
      });
    };
    input?.addEventListener('change', () => {
      files = Array.from(input.files ?? []);
      if (status) status.textContent = webpWritable ? '' : root.dataset.webpUnsupported ?? '';
      render();
    });
    quality?.addEventListener('input', () => {
      if (qualityOutput) qualityOutput.value = `${quality.value}%`;
    });

    const convertFile = async (file: File, mime: string, outputQuality: number) => {
      const image = await decodeImage(file);
      const canvas = document.createElement('canvas');
      canvas.width = image.width;
      canvas.height = image.height;
      const context = canvas.getContext('2d');
      if (!context) throw new Error('canvas');
      if (mime === 'image/jpeg') {
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, canvas.width, canvas.height);
      }
      context.drawImage(image, 0, 0);
      closeImage(image);
      const encoded = await encodeCanvas(canvas, mime, outputQuality);
      if (!encoded) throw new Error('encode');
      return encoded;
    };
    root.querySelector('[data-action="convert"]')?.addEventListener('click', async () => {
      if (!files.length) {
        if (status) status.textContent = root.dataset.empty ?? '';
        return;
      }
      const button = root.querySelector<HTMLButtonElement>('[data-action="convert"]');
      if (button) button.disabled = true;
      if (status) status.textContent = root.dataset.working ?? '';
      const mime = format?.value ?? 'image/webp';
      const outputQuality = Number(quality?.value ?? 85) / 100;
      const converted: Array<{ base: string; extension: string; blob: Blob }> = [];
      const failedNames: string[] = [];
      let fellBack = false;
      try {
        // One file failing no longer stops the rest; it is named at the end.
        for (const file of files) {
          try {
            const encoded = await convertFile(file, mime, outputQuality);
            if (encoded.fellBack) fellBack = true;
            const base = file.name.replace(/\.[^.]+$/u, '') || 'image';
            converted.push({ base, extension: extensionFor(encoded.type), blob: encoded.blob });
          } catch {
            failedNames.push(file.name);
          }
        }

        // Several downloads in a row trip Chrome's "multiple files" prompt and
        // are blocked on iOS once the tap is over, so two or more go out as
        // one ZIP, the same way PDF to image does it.
        if (converted.length === 1) {
          downloadBlob(converted[0].blob, `${converted[0].base}.${converted[0].extension}`);
        }
        if (converted.length > 1) {
          const { writeZip, zipSafeBase } = await import('../../lib/zip-write');
          const entries = [];
          const usedNames = new Set<string>();
          for (const item of converted) {
            // A `\` or a very long name would make the ZIP refuse the whole
            // batch, so the entry name is cleaned rather than the file lost.
            const base = zipSafeBase(item.base);
            // a.png and a.jpg both become a.webp; inside one ZIP they need
            // different names or the second replaces the first. Compared
            // without case, since Windows treats A.webp and a.webp as one file.
            let name = `${base}.${item.extension}`;
            let copyNumber = 2;
            while (usedNames.has(name.toLowerCase())) {
              name = `${base}-${copyNumber}.${item.extension}`;
              copyNumber += 1;
            }
            usedNames.add(name.toLowerCase());
            entries.push({ name, bytes: new Uint8Array(await item.blob.arrayBuffer()) });
          }
          downloadBlob(writeZip(entries), 'utilark-images.zip');
        }

        const messages: string[] = [];
        if (converted.length) messages.push(`${converted.length}${root.dataset.done ?? ''}`);
        if (failedNames.length) messages.push(`${root.dataset.failedFiles ?? ''} ${failedNames.join(', ')}`);
        if (fellBack) messages.push(root.dataset.webpUnsupported ?? '');
        if (status) status.textContent = messages.join(' ');
      } catch {
        if (status) status.textContent = root.dataset.failed ?? '';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
