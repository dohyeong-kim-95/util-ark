---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = locale === 'ko'
  ? {
      pick: 'PDF 고르기',
      hint: '브라우저 안에서 그리며 업로드하지 않습니다.',
      pages: '쪽 번호',
      pagesHint: '비워 두면 전체입니다. 예: 1-3, 7',
      format: '형식',
      formatPng: 'PNG (글자가 또렷함)',
      formatJpg: 'JPG (파일이 작음)',
      resolution: '해상도',
      resScreen: '화면용 (96 DPI)',
      resDoc: '문서용 (150 DPI)',
      resPrint: '인쇄용 (300 DPI)',
      save: '이미지로 저장',
      loading: 'PDF를 여는 중…',
      working: '그리는 중',
      done: '내려받았습니다.',
      zipNote: '두 쪽 이상이면 ZIP 하나로 묶어 내려받습니다.',
      pageCount: '전체 {n}쪽',
      errEncrypted: '암호가 걸린 PDF입니다. 암호를 푼 뒤 다시 올려 주세요.',
      errInvalid: 'PDF 파일이 아닙니다.',
      errFailed: '처리하지 못했습니다.',
    }
  : {
      pick: 'Choose a PDF',
      hint: 'Drawn in your browser and never uploaded.',
      pages: 'Pages',
      pagesHint: 'Leave empty for all of them. For example 1-3, 7',
      format: 'Format',
      formatPng: 'PNG (sharper text)',
      formatJpg: 'JPG (smaller files)',
      resolution: 'Resolution',
      resScreen: 'Screen (96 DPI)',
      resDoc: 'Document (150 DPI)',
      resPrint: 'Print (300 DPI)',
      save: 'Save as images',
      loading: 'Opening the PDF…',
      working: 'Drawing',
      done: 'Downloaded.',
      zipNote: 'More than one page arrives as a single ZIP.',
      pageCount: '{n} pages',
      errEncrypted: 'That PDF is password protected. Remove the password and try again.',
      errInvalid: 'That is not a PDF.',
      errFailed: 'The file could not be processed.',
    };
---

<div class="pdf-tool pdf-image-tool" data-locale={locale} data-copy={JSON.stringify(labels)}>
  <label class="drop-zone">
    <input type="file" accept="application/pdf,.pdf" />
    <strong>{labels.pick}</strong>
    <span>{labels.hint}</span>
  </label>

  <div class="pdf-workspace" data-workspace hidden>
    <div class="option-grid">
      <label>
        <span>{labels.pages}</span>
        <input type="text" data-option="pages" inputmode="numeric" autocomplete="off" placeholder="1-3, 7" />
      </label>
      <label>
        <span>{labels.format}</span>
        <select data-option="format">
          <option value="png">{labels.formatPng}</option>
          <option value="jpg">{labels.formatJpg}</option>
        </select>
      </label>
      <label>
        <span>{labels.resolution}</span>
        <select data-option="dpi">
          <option value="96">{labels.resScreen}</option>
          <option value="150" selected>{labels.resDoc}</option>
          <option value="300">{labels.resPrint}</option>
        </select>
      </label>
    </div>
    <p class="pdf-hint" data-hint>{labels.pagesHint}</p>

    <div class="tool-actions">
      <button type="button" class="primary" data-action="save">{labels.save}</button>
      <span class="action-status" role="status"></span>
    </div>
  </div>
</div>

<script>
  import { PageSelectionError, pageFileName, parsePages } from '../../lib/pdf-pages';
  import { PdfError } from '../../lib/pdf-text';

  const root = document.querySelector<HTMLElement>('.pdf-image-tool');
  if (root) {
    const copy = JSON.parse(root.dataset.copy || '{}') as Record<string, string>;
    const picker = root.querySelector<HTMLInputElement>('input[type="file"]');
    const workspace = root.querySelector<HTMLElement>('[data-workspace]');
    const pagesInput = root.querySelector<HTMLInputElement>('[data-option="pages"]');
    const formatSelect = root.querySelector<HTMLSelectElement>('[data-option="format"]');
    const dpiSelect = root.querySelector<HTMLSelectElement>('[data-option="dpi"]');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const saveButton = root.querySelector<HTMLButtonElement>('[data-action="save"]');
    const status = root.querySelector<HTMLElement>('.action-status');

    let file: File | null = null;
    let pageCount = 0;

    const say = (message: string) => { if (status) status.textContent = message; };

    const messageFor = (error: unknown) => {
      if (error instanceof PdfError) {
        if (error.reason === 'encrypted') return copy.errEncrypted;
        if (error.reason === 'invalid') return copy.errInvalid;
      }
      if (error instanceof PageSelectionError) return error.message;
      return copy.errFailed;
    };

    picker?.addEventListener('change', async () => {
      file = picker.files?.[0] ?? null;
      if (!file) return;
      say(copy.loading);
      try {
        const { openPdf } = await import('../../lib/pdf-render');
        // Opened once just to learn the page count, then closed: the export
        // opens it again from the untouched file.
        const pdf = await openPdf((await file.arrayBuffer()).slice(0));
        pageCount = pdf.pageCount;
        await pdf.close();
        if (workspace) workspace.hidden = false;
        if (hint) {
          hint.textContent = `${copy.pageCount.replace('{n}', String(pageCount))} · ${copy.pagesHint} · ${copy.zipNote}`;
        }
        say('');
      } catch (error) {
        say(messageFor(error));
      }
    });

    saveButton?.addEventListener('click', async () => {
      if (!file || !saveButton) return;
      saveButton.disabled = true;

      try {
        const wanted = pagesInput?.value.trim()
          ? parsePages(pagesInput.value, pageCount)
          : Array.from({ length: pageCount }, (_unused, index) => index + 1);
        const asJpeg = formatSelect?.value === 'jpg';
        const type = asJpeg ? 'image/jpeg' : 'image/png';
        const extension = asJpeg ? 'jpg' : 'png';
        const dpi = Number(dpiSelect?.value ?? 150);

        const { openPdf, scaleForDpi } = await import('../../lib/pdf-render');
        const pdf = await openPdf(await file.arrayBuffer());
        const stem = file.name.replace(/\.[^.]+$/u, '') || 'utilark';

        try {
          const rendered: Array<{ name: string; bytes: Uint8Array; blob: Blob }> = [];
          for (const page of wanted) {
            say(`${copy.working} ${rendered.length + 1} / ${wanted.length}`);
            const image = await pdf.render(page, scaleForDpi(dpi), type, asJpeg ? 0.9 : 1);
            rendered.push({
              name: pageFileName(file.name, page, pageCount, extension),
              bytes: new Uint8Array(await image.blob.arrayBuffer()),
              blob: image.blob,
            });
          }

          // A single page is the file itself. Wrapping one image in a ZIP makes
          // the visitor unpack an archive to reach what they asked for.
          let blob: Blob;
          let name: string;
          if (rendered.length === 1) {
            blob = rendered[0].blob;
            name = rendered[0].name;
          } else {
            const { writeZip } = await import('../../lib/zip-write');
            blob = writeZip(rendered.map(({ name: entry, bytes }) => ({ name: entry, bytes })));
            name = `${stem}-${extension}.zip`;
          }

          const url = URL.createObjectURL(blob);
          const anchor = document.createElement('a');
          anchor.href = url;
          anchor.download = name;
          anchor.click();
          window.setTimeout(() => URL.revokeObjectURL(url), 1000);
          say(copy.done);
        } finally {
          await pdf.close();
        }
      } catch (error) {
        say(messageFor(error));
      } finally {
        saveButton.disabled = false;
      }
    });
  }
</script>
