---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = locale === 'ko'
  ? {
      people: '인원',
      fewer: '인원 줄이기',
      more: '인원 늘리기',
      fillWin: '당첨 하나',
      fillRank: '순서대로',
      namesLabel: '참가자 이름',
      prizesLabel: '결과',
      namePlaceholder: '이름',
      prizePlaceholder: '결과',
      ladder: '사다리',
      build: '사다리 만들기',
      revealAll: '전체 보기',
      rebuild: '다시 만들기',
      edit: '고치기',
      hintEdit: '칸을 채우고 사다리를 만드세요.',
      hintPlay: '이름을 누르면 그 줄이 어디로 내려가는지 따라 그립니다.',
      hintDone: '결과가 모두 나왔습니다.',
      resultsLabel: '결과 목록',
      win: '당첨',
      lose: '꽝',
      rank: '등',
      slot: '번 칸',
      person: '번',
    }
  : {
      people: 'People',
      fewer: 'Fewer people',
      more: 'More people',
      fillWin: 'One winner',
      fillRank: 'Rank order',
      namesLabel: 'Participant names',
      prizesLabel: 'Outcomes',
      namePlaceholder: 'Name',
      prizePlaceholder: 'Outcome',
      ladder: 'Ladder',
      build: 'Build the ladder',
      revealAll: 'Reveal all',
      rebuild: 'Build again',
      edit: 'Edit',
      hintEdit: 'Fill in the boxes, then build the ladder.',
      hintPlay: 'Tap a name to trace where that line comes down.',
      hintDone: 'Every line has been traced.',
      resultsLabel: 'Results',
      win: 'Winner',
      lose: 'No win',
      rank: '',
      slot: '',
      person: '',
    };

const ordinal = locale === 'ko'
  ? { rankSuffix: '등', slotSuffix: '번 칸', personSuffix: '번' }
  : { rankSuffix: '', slotSuffix: '', personSuffix: '' };
---

<div
  class="ladder-tool"
  data-locale={locale}
  data-label-win={labels.win}
  data-label-lose={labels.lose}
  data-rank-suffix={ordinal.rankSuffix}
  data-slot-suffix={ordinal.slotSuffix}
  data-person-suffix={ordinal.personSuffix}
  data-hint-edit={labels.hintEdit}
  data-hint-play={labels.hintPlay}
  data-hint-done={labels.hintDone}
>
  <div class="ladder-setup">
    <span class="field-label">{labels.people}</span>
    <div class="ladder-stepper">
      <button type="button" data-action="fewer" aria-label={labels.fewer}>−</button>
      <span data-count aria-live="polite">4</span>
      <button type="button" data-action="more" aria-label={labels.more}>+</button>
    </div>
    <button type="button" class="ghost" data-action="fill-win">{labels.fillWin}</button>
    <button type="button" class="ghost" data-action="fill-rank">{labels.fillRank}</button>
  </div>

  <div class="ladder-stage">
    <div class="ladder-row" data-names role="group" aria-label={labels.namesLabel}></div>
    <svg data-ladder role="img" aria-label={labels.ladder}></svg>
    <div class="ladder-row" data-prizes role="group" aria-label={labels.prizesLabel}></div>
  </div>
  <p class="ladder-hint" data-hint>{labels.hintEdit}</p>

  <div class="tool-actions">
    <button type="button" class="primary" data-action="build">{labels.build}</button>
    <button type="button" class="secondary" data-action="reveal" hidden>{labels.revealAll}</button>
    <button type="button" class="ghost" data-action="rebuild" hidden>{labels.rebuild}</button>
    <button type="button" class="ghost" data-action="edit" hidden>{labels.edit}</button>
  </div>

  <ul class="ladder-results" data-results aria-label={labels.resultsLabel}></ul>
</div>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const MIN = 2;
  const MAX = 8;

  const root = document.querySelector<HTMLElement>('.ladder-tool');
  if (root) {
    const find = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector);
    const namesRow = find<HTMLElement>('[data-names]');
    const prizesRow = find<HTMLElement>('[data-prizes]');
    const svg = root.querySelector<SVGSVGElement>('[data-ladder]');
    const resultsList = find<HTMLElement>('[data-results]');
    const hint = find<HTMLElement>('[data-hint]');
    const countValue = find<HTMLElement>('[data-count]');
    const text = (key: string) => root.dataset[key] ?? '';

    let people = 4;
    let names: string[] = [];
    let prizes: string[] = [];
    let rows = 0;
    let rungs = new Set<string>();
    let phase: 'edit' | 'play' = 'edit';
    const results = new Map<number, number>();
    let running = 0;
    let width = 0;
    let height = 0;

    const nameOf = (index: number) =>
      (names[index] || '').trim() || `${index + 1}${text('personSuffix')}`;
    const prizeOf = (index: number) =>
      (prizes[index] || '').trim() || `${index + 1}${text('slotSuffix')}`;
    const color = (index: number) => `hsl(${(index * 360) / people + 12} 68% 44%)`;

    const shuffledRows = () => {
      const order = Array.from({ length: rows }, (_, i) => i);
      for (let i = order.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [order[i], order[j]] = [order[j], order[i]];
      }
      return order;
    };

    /* 가로칸이 이웃하면 갈림길이 사라지므로 바로 옆 칸이 이미 있으면 건너뛴다. */
    const makeRungs = () => {
      rows = Math.max(7, people + 4);
      rungs = new Set();
      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < people - 1; c++) {
          if (rungs.has(`${r}:${c - 1}`)) continue;
          if (Math.random() < 0.42) rungs.add(`${r}:${c}`);
        }
      }
      // 한 번도 쓰이지 않은 세로 간격이 있으면 제자리로 내려오는 줄이 생긴다.
      for (let c = 0; c < people - 1; c++) {
        let used = false;
        for (let r = 0; r < rows && !used; r++) used = rungs.has(`${r}:${c}`);
        if (used) continue;
        for (const r of shuffledRows()) {
          if (rungs.has(`${r}:${c - 1}`) || rungs.has(`${r}:${c + 1}`)) continue;
          rungs.add(`${r}:${c}`);
          break;
        }
      }
    };

    const columnX = (column: number) => (width * (column + 0.5)) / people;
    const rowY = (row: number) => (height * (row + 1)) / (rows + 1);

    const walk = (start: number) => {
      let column = start;
      const points: Array<[number, number]> = [[columnX(column), 0]];
      for (let r = 0; r < rows; r++) {
        const next = rungs.has(`${r}:${column}`)
          ? column + 1
          : rungs.has(`${r}:${column - 1}`)
            ? column - 1
            : column;
        if (next === column) continue;
        points.push([columnX(column), rowY(r)], [columnX(next), rowY(r)]);
        column = next;
      }
      points.push([columnX(column), height]);
      return { points, end: column };
    };

    const cell = (index: number, kind: 'name' | 'prize') => {
      const input = document.createElement('input');
      input.className = `ladder-cell ${kind}`;
      input.maxLength = 6;
      input.autocomplete = 'off';
      input.value = (kind === 'name' ? names[index] : prizes[index]) || '';
      input.placeholder = kind === 'name'
        ? `${index + 1}${text('personSuffix')}`
        : `${index + 1}${text('slotSuffix')}`;
      input.readOnly = phase === 'play';
      if (kind === 'name') {
        input.style.setProperty('--tone', color(index));
        input.addEventListener('click', () => {
          if (phase === 'play') trace(index);
        });
      }
      input.addEventListener('input', () => {
        (kind === 'name' ? names : prizes)[index] = input.value;
      });
      return input;
    };

    const markPrize = (who: number, end: number) => {
      const target = prizesRow?.children[end] as HTMLElement | undefined;
      if (!target) return;
      target.classList.add('is-hit');
      target.style.setProperty('--tone', color(who));
    };

    const renderCells = () => {
      if (!namesRow || !prizesRow) return;
      namesRow.style.setProperty('--columns', String(people));
      prizesRow.style.setProperty('--columns', String(people));
      root.style.setProperty('--cell-size', people > 6 ? '0.62rem' : people > 4 ? '0.72rem' : '0.85rem');
      namesRow.replaceChildren(...Array.from({ length: people }, (_, i) => cell(i, 'name')));
      prizesRow.replaceChildren(...Array.from({ length: people }, (_, i) => cell(i, 'prize')));
      for (const [who, end] of results) markPrize(who, end);
    };

    const line = (x1: number, y1: number, x2: number, y2: number) => {
      const element = document.createElementNS(NS, 'line');
      element.setAttribute('x1', String(x1));
      element.setAttribute('y1', String(y1));
      element.setAttribute('x2', String(x2));
      element.setAttribute('y2', String(y2));
      return element;
    };

    const dot = (who: number, end: number) => {
      if (!svg) return;
      const circle = document.createElementNS(NS, 'circle');
      circle.setAttribute('cx', String(columnX(end)));
      circle.setAttribute('cy', String(height - 3));
      circle.setAttribute('r', '5');
      circle.setAttribute('fill', color(who));
      svg.appendChild(circle);
    };

    const renderResults = () => {
      if (!resultsList) return;
      const done = [...results.keys()].sort((a, b) => a - b);
      resultsList.replaceChildren(
        ...done.map((index) => {
          const item = document.createElement('li');
          const who = document.createElement('strong');
          who.textContent = nameOf(index);
          who.style.color = color(index);
          const arrow = document.createElement('span');
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '→';
          const prize = document.createElement('span');
          prize.textContent = prizeOf(results.get(index) ?? 0);
          item.append(who, arrow, prize);
          return item;
        }),
      );
    };

    const drawTrace = (who: number, animate: boolean) => {
      if (!svg) return;
      const { points, end } = walk(who);
      const path = document.createElementNS(NS, 'path');
      path.setAttribute('class', 'trace');
      path.setAttribute('stroke', color(who));
      path.setAttribute(
        'd',
        points.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' '),
      );
      svg.appendChild(path);

      if (!animate) {
        dot(who, end);
        return;
      }

      const length = path.getTotalLength();
      const seconds = Math.max(0.9, Math.min(2.2, length / 420));
      path.style.strokeDasharray = String(length);
      path.style.strokeDashoffset = String(length);
      running += 1;
      let settled = false;
      const finish = () => {
        if (settled) return;
        settled = true;
        running -= 1;
        dot(who, end);
        markPrize(who, end);
        renderResults();
        updateControls();
      };
      requestAnimationFrame(() => {
        path.style.transition = `stroke-dashoffset ${seconds}s linear`;
        path.style.strokeDashoffset = '0';
      });
      path.addEventListener('transitionend', finish, { once: true });
      // 탭이 백그라운드로 가면 transitionend가 오지 않는다.
      window.setTimeout(finish, seconds * 1000 + 400);
    };

    const draw = () => {
      if (!svg) return;
      width = svg.clientWidth || namesRow?.clientWidth || 320;
      height = Math.round(Math.min(340, Math.max(230, window.innerHeight * 0.38)));
      svg.setAttribute('viewBox', `0 0 ${width} ${height}`);
      svg.setAttribute('height', String(height));
      svg.style.height = `${height}px`;

      const grid = document.createElementNS(NS, 'g');
      grid.setAttribute('class', 'grid');
      for (let c = 0; c < people; c++) grid.appendChild(line(columnX(c), 0, columnX(c), height));
      for (const key of rungs) {
        const [r, c] = key.split(':').map(Number);
        grid.appendChild(line(columnX(c), rowY(r), columnX(c + 1), rowY(r)));
      }
      svg.replaceChildren(grid);
      for (const [who] of results) drawTrace(who, false);
    };

    const trace = (who: number) => {
      if (results.has(who)) return;
      results.set(who, walk(who).end);
      drawTrace(who, true);
      updateControls();
    };

    const updateControls = () => {
      const playing = phase === 'play';
      const toggle = (selector: string, hidden: boolean) => {
        const button = find<HTMLButtonElement>(selector);
        if (button) button.hidden = hidden;
      };
      toggle('[data-action="build"]', playing);
      toggle('[data-action="reveal"]', !playing);
      toggle('[data-action="rebuild"]', !playing);
      toggle('[data-action="edit"]', !playing);

      const disable = (selector: string, disabled: boolean) => {
        const button = find<HTMLButtonElement>(selector);
        if (button) button.disabled = disabled;
      };
      disable('[data-action="fewer"]', playing || people <= MIN);
      disable('[data-action="more"]', playing || people >= MAX);
      disable('[data-action="fill-win"]', playing);
      disable('[data-action="fill-rank"]', playing);
      disable('[data-action="reveal"]', results.size >= people);

      if (countValue) countValue.textContent = String(people);
      if (hint) {
        hint.textContent = !playing
          ? text('hintEdit')
          : results.size >= people
            ? text('hintDone')
            : text('hintPlay');
      }
    };

    const setPhase = (next: 'edit' | 'play') => {
      phase = next;
      if (phase === 'edit') {
        rungs = new Set();
        rows = 0;
        results.clear();
      }
      renderCells();
      renderResults();
      draw();
      updateControls();
    };

    const setPeople = (next: number) => {
      people = Math.max(MIN, Math.min(MAX, next));
      names.length = people;
      prizes.length = people;
      setPhase('edit');
    };

    find<HTMLButtonElement>('[data-action="fewer"]')?.addEventListener('click', () => setPeople(people - 1));
    find<HTMLButtonElement>('[data-action="more"]')?.addEventListener('click', () => setPeople(people + 1));
    find<HTMLButtonElement>('[data-action="fill-win"]')?.addEventListener('click', () => {
      prizes = Array.from({ length: people }, (_, i) => (i === 0 ? text('labelWin') : text('labelLose')));
      renderCells();
    });
    find<HTMLButtonElement>('[data-action="fill-rank"]')?.addEventListener('click', () => {
      prizes = Array.from({ length: people }, (_, i) => `${i + 1}${text('rankSuffix')}`);
      renderCells();
    });
    find<HTMLButtonElement>('[data-action="build"]')?.addEventListener('click', () => {
      makeRungs();
      setPhase('play');
    });
    find<HTMLButtonElement>('[data-action="rebuild"]')?.addEventListener('click', () => {
      if (running) return;
      makeRungs();
      setPhase('play');
    });
    find<HTMLButtonElement>('[data-action="edit"]')?.addEventListener('click', () => setPhase('edit'));
    find<HTMLButtonElement>('[data-action="reveal"]')?.addEventListener('click', () => {
      const rest: number[] = [];
      for (let i = 0; i < people; i++) if (!results.has(i)) rest.push(i);
      rest.forEach((index, order) => window.setTimeout(() => trace(index), order * 140));
    });

    // 회전이나 창 크기 변경으로 폭이 바뀌면 좌표를 다시 잡는다.
    let lastWidth = 0;
    if (svg) {
      new ResizeObserver(() => {
        const next = svg.clientWidth;
        if (!next || next === lastWidth || running) return;
        lastWidth = next;
        draw();
      }).observe(svg);
    }

    prizes = Array.from({ length: people }, (_, i) => (i === 0 ? text('labelWin') : text('labelLose')));
    setPhase('edit');
  }
</script>
