---
import type { Locale } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = locale === 'ko'
  ? {
      pick: '사진 선택',
      hint: 'JPG, PNG, WebP · 카메라로 바로 찍어도 됩니다',
      page: '페이지 크기',
      pageFit: '사진 비율 그대로',
      pageA4: 'A4 (여백 포함)',
      quality: '해상도',
      qualityScreen: '화면·전송용 (긴 변 1600px)',
      qualityPrint: '인쇄용 (긴 변 2400px)',
      qualityFull: '원본 그대로',
      build: 'PDF 만들기',
      empty: '사진을 한 장 이상 선택해주세요.',
      working: 'PDF를 만드는 중…',
      done: 'PDF를 내려받았습니다.',
      failed: 'PDF를 만들지 못했습니다.',
      up: '위로',
      down: '아래로',
      remove: '삭제',
    }
  : {
      pick: 'Choose photos',
      hint: 'JPG, PNG, WebP · you can shoot straight from the camera',
      page: 'Page size',
      pageFit: 'Match each photo',
      pageA4: 'A4 with margins',
      quality: 'Resolution',
      qualityScreen: 'Screen & sharing (1600px long edge)',
      qualityPrint: 'Printing (2400px long edge)',
      qualityFull: 'Full resolution',
      build: 'Create PDF',
      empty: 'Choose at least one photo.',
      working: 'Building the PDF…',
      done: 'Your PDF has been downloaded.',
      failed: 'Could not build the PDF.',
      up: 'Move up',
      down: 'Move down',
      remove: 'Remove',
    };
---

<div
  class="pdf-tool imagepdf-tool"
  data-empty={labels.empty}
  data-working={labels.working}
  data-done={labels.done}
  data-failed={labels.failed}
  data-up={labels.up}
  data-down={labels.down}
  data-remove={labels.remove}
>
  <label class="drop-zone">
    <input type="file" accept="image/*" multiple />
    <strong>{labels.pick}</strong>
    <span>{labels.hint}</span>
  </label>

  <div class="file-list" aria-live="polite"></div>

  <div class="option-grid">
    <label>
      <span>{labels.page}</span>
      <select data-option="page">
        <option value="fit">{labels.pageFit}</option>
        <option value="a4">{labels.pageA4}</option>
      </select>
    </label>
    <label>
      <span>{labels.quality}</span>
      <select data-option="scale">
        <option value="1600">{labels.qualityScreen}</option>
        <option value="2400">{labels.qualityPrint}</option>
        <option value="0">{labels.qualityFull}</option>
      </select>
    </label>
  </div>

  <div class="tool-actions">
    <button type="button" class="primary" data-action="build">{labels.build}</button>
    <span class="action-status" role="status"></span>
  </div>
</div>

<script>
  import { PDFDocument } from 'pdf-lib';

  const root = document.querySelector<HTMLElement>('.imagepdf-tool');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('input[type="file"]');
    const list = root.querySelector<HTMLElement>('.file-list');
    const pageSelect = root.querySelector<HTMLSelectElement>('[data-option="page"]');
    const scaleSelect = root.querySelector<HTMLSelectElement>('[data-option="scale"]');
    const status = root.querySelector<HTMLElement>('.action-status');
    let files: File[] = [];

    // A4 at 72 points per inch, the unit pdf-lib works in.
    const A4 = { width: 595.28, height: 841.89 };
    const A4_MARGIN = 36;

    const move = (index: number, direction: number) => {
      const target = index + direction;
      if (target < 0 || target >= files.length) return;
      [files[index], files[target]] = [files[target], files[index]];
      render();
    };
    const render = () => {
      if (!list) return;
      list.replaceChildren();
      files.forEach((file, index) => {
        const row = document.createElement('div');
        row.className = 'file-row pdf-row';
        const number = document.createElement('span');
        number.className = 'file-number';
        number.textContent = String(index + 1);
        const name = document.createElement('strong');
        name.textContent = file.name;
        const controls = document.createElement('span');
        controls.className = 'row-controls';
        const buttons = [
          { text: '↑', label: root.dataset.up, action: () => move(index, -1), disabled: index === 0 },
          { text: '↓', label: root.dataset.down, action: () => move(index, 1), disabled: index === files.length - 1 },
          { text: '×', label: root.dataset.remove, action: () => { files.splice(index, 1); render(); }, disabled: false },
        ];
        buttons.forEach((item) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'icon-button';
          button.textContent = item.text;
          button.disabled = item.disabled;
          button.setAttribute('aria-label', `${item.label}: ${file.name}`);
          button.addEventListener('click', item.action);
          controls.append(button);
        });
        row.append(number, name, controls);
        list.append(row);
      });
    };

    const decode = async (file: File) => {
      // A phone photo stores landscape pixels plus an EXIF rotation tag, so ask
      // for the tag to be applied or every portrait page lands on its side.
      if ('createImageBitmap' in window) {
        return createImageBitmap(file, { imageOrientation: 'from-image' })
          .catch(() => createImageBitmap(file));
      }
      return new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        const url = URL.createObjectURL(file);
        image.onload = () => { URL.revokeObjectURL(url); resolve(image); };
        image.onerror = () => { URL.revokeObjectURL(url); reject(new Error('decode')); };
        image.src = url;
      });
    };

    /**
     * pdf-lib embeds JPG and PNG only, and a phone photo at full resolution
     * makes a PDF nobody can email. Redrawing through a canvas solves both: it
     * produces a format pdf-lib accepts, applies the size limit, and drops the
     * EXIF metadata — including where the photo was taken — on the way.
     */
    const prepare = async (file: File, limit: number) => {
      const bitmap = await decode(file);
      const width = 'width' in bitmap ? bitmap.width : 0;
      const height = 'height' in bitmap ? bitmap.height : 0;
      if (!width || !height) throw new Error('decode');
      const longest = Math.max(width, height);
      const factor = limit > 0 && longest > limit ? limit / longest : 1;
      const canvas = document.createElement('canvas');
      canvas.width = Math.round(width * factor);
      canvas.height = Math.round(height * factor);
      const context = canvas.getContext('2d');
      if (!context) throw new Error('canvas');
      // PNG keeps transparency for logos and screenshots; everything else goes
      // out as JPG, which is what keeps a photo album to a sendable size.
      // Decide this first: a transparent WebP re-encoded as JPG without a
      // background turns its transparent areas black, since JPG has no alpha.
      const type = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
      if (type === 'image/jpeg') {
        context.fillStyle = '#ffffff';
        context.fillRect(0, 0, canvas.width, canvas.height);
      }
      context.drawImage(bitmap as CanvasImageSource, 0, 0, canvas.width, canvas.height);
      if ('close' in bitmap && typeof bitmap.close === 'function') bitmap.close();
      const blob = await new Promise<Blob | null>((resolve) => canvas.toBlob(resolve, type, 0.85));
      if (!blob) throw new Error('encode');
      return { bytes: new Uint8Array(await blob.arrayBuffer()), type, width: canvas.width, height: canvas.height };
    };

    input?.addEventListener('change', () => {
      files = Array.from(input.files ?? []).filter((file) => file.type.startsWith('image/'));
      if (status) status.textContent = '';
      render();
    });

    root.querySelector('[data-action="build"]')?.addEventListener('click', async () => {
      if (files.length === 0) {
        if (status) status.textContent = root.dataset.empty ?? '';
        return;
      }
      const button = root.querySelector<HTMLButtonElement>('[data-action="build"]');
      if (button) button.disabled = true;
      if (status) status.textContent = root.dataset.working ?? '';
      try {
        const limit = Number(scaleSelect?.value ?? 1600);
        const onA4 = pageSelect?.value === 'a4';
        const pdf = await PDFDocument.create();
        for (const file of files) {
          const image = await prepare(file, limit);
          const embedded = image.type === 'image/png'
            ? await pdf.embedPng(image.bytes)
            : await pdf.embedJpg(image.bytes);
          if (onA4) {
            // Portrait photos would overflow a portrait page, so turn the page
            // instead of shrinking the picture into a stripe.
            const landscape = image.width > image.height;
            const pageWidth = landscape ? A4.height : A4.width;
            const pageHeight = landscape ? A4.width : A4.height;
            const page = pdf.addPage([pageWidth, pageHeight]);
            const box = embedded.scaleToFit(pageWidth - A4_MARGIN * 2, pageHeight - A4_MARGIN * 2);
            page.drawImage(embedded, {
              x: (pageWidth - box.width) / 2,
              y: (pageHeight - box.height) / 2,
              width: box.width,
              height: box.height,
            });
          } else {
            const page = pdf.addPage([image.width, image.height]);
            page.drawImage(embedded, { x: 0, y: 0, width: image.width, height: image.height });
          }
        }
        const bytes = await pdf.save();
        const safeBytes = new Uint8Array(bytes.byteLength);
        safeBytes.set(bytes);
        const blob = new Blob([safeBytes], { type: 'application/pdf' });
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');
        anchor.href = url;
        anchor.download = 'utilark-photos.pdf';
        anchor.click();
        window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        if (status) status.textContent = root.dataset.done ?? '';
      } catch {
        if (status) status.textContent = root.dataset.failed ?? '';
      } finally {
        if (button) button.disabled = false;
      }
    });
  }
</script>
