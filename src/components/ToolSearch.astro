---
import { searchIndex } from '../lib/search-index';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].home;
const entries = searchIndex(locale);
// `</script>` inside a JSON island would close the tag early; the `<` escape is
// the standard way out and JSON.parse reads it back unchanged.
const indexJson = JSON.stringify(entries).replace(/</gu, '\\u003c');
---

{/* The field is hidden until the script that powers it is running, so a page
    with a broken bundle shows the grid rather than a box that does nothing. */}
<div class="tool-search" data-tool-search hidden>
  <input
    type="search"
    id="tool-search-input"
    data-search-input
    autocomplete="off"
    autocapitalize="off"
    spellcheck="false"
    aria-label={t.searchLabel}
    placeholder={t.searchPlaceholder}
  />
  <button type="button" class="search-clear" data-search-clear aria-label={t.searchClear} hidden>✕</button>
</div>
<p class="search-status" data-search-status hidden aria-live="polite"></p>
{/* Same class as the grid it replaces: a result is the tool card, not a
    smaller stand-in for it. */}
<div class="tool-grid" data-search-results hidden></div>

<script is:inline type="application/json" data-search-index set:html={indexJson} />

<script>
  import { searchEntries, type SearchEntry } from '../lib/search-rules';

  const box = document.querySelector<HTMLElement>('[data-tool-search]');
  const input = document.querySelector<HTMLInputElement>('[data-search-input]');
  const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
  const status = document.querySelector<HTMLElement>('[data-search-status]');
  const results = document.querySelector<HTMLElement>('[data-search-results]');
  const indexNode = document.querySelector<HTMLElement>('[data-search-index]');
  const grid = document.querySelector<HTMLElement>('[data-tool-grid]');

  if (box && input && clear && status && results && indexNode && grid) {
    const locale = document.documentElement.lang === 'ko' ? 'ko' : 'en';
    const copy = locale === 'ko'
      ? {
          empty: '검색 결과가 없습니다. 도구 이름 말고 영문 주소(png-to-jpg)나 초성(ㅅㄷㄹ)으로도 찾을 수 있습니다.',
          count: (n: number) => `${n}개를 찾았습니다. Enter를 누르면 첫 번째가 열립니다.`,
        }
      : {
          empty: 'Nothing matched. Besides the tool name, the address (png-to-jpg) and Korean initials both work.',
          count: (n: number) => `${n} result${n === 1 ? '' : 's'}. Press Enter to open the first.`,
        };

    const entries: SearchEntry[] = JSON.parse(indexNode.textContent || '[]');

    box.hidden = false;

    const esc = (value: string) =>
      value.replace(/[&<>]/gu, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[ch] as string);
    const escAttr = (value: string) => esc(value).replace(/"/gu, '&quot;');

    let found = searchEntries([], '');

    const render = () => {
      const query = input.value;
      clear.hidden = !query;

      if (!query.trim()) {
        found = [];
        results.hidden = true;
        status.hidden = true;
        results.replaceChildren();
        grid.hidden = false;
        return;
      }

      found = searchEntries(entries, query, { locale });
      grid.hidden = true;
      status.hidden = false;
      results.hidden = found.length === 0;
      // Mirrors ToolCard.astro exactly, plus the category line — results mix
      // tools, conversion pages and guides, and the card is the same shape for
      // all three. Change one and change the other.
      results.innerHTML = found
        .map(({ entry }) =>
          `<article class="tool-card" style="--tool-accent:${escAttr(entry.accent)}">` +
            `<div class="tool-icon" aria-hidden="true">${esc(entry.icon)}</div>` +
            `<div><span class="card-kind">${esc(entry.kind)}</span>` +
            `<h3><a href="${escAttr(entry.url)}">${esc(entry.title)}</a></h3>` +
            `<p>${esc(entry.desc)}</p></div>` +
            `<a class="card-action" href="${escAttr(entry.url)}">${esc(entry.action)}<span aria-hidden="true">↗</span></a>` +
          `</article>`)
        .join('');
      status.textContent = found.length ? copy.count(found.length) : copy.empty;
    };

    input.addEventListener('input', render);
    input.addEventListener('keydown', (event) => {
      // While an IME is composing, Enter commits the Korean syllable — it is not
      // a request to navigate away.
      if (event.isComposing) return;
      if (event.key === 'Enter' && found.length) location.href = found[0].entry.url;
      if (event.key === 'Escape') { input.value = ''; render(); }
    });
    clear.addEventListener('click', () => { input.value = ''; render(); input.focus(); });
    // '/' jumps into the field on a desktop keyboard.
    addEventListener('keydown', (event) => {
      if (event.key !== '/' || event.target === input || event.metaKey || event.ctrlKey) return;
      const tag = (event.target as HTMLElement | null)?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;
      event.preventDefault();
      input.focus();
    });

    render();
  }
</script>
