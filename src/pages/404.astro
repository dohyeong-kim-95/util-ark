---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#111319" />
    <title>Page not found · Utilark</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="language-gate">
    <main class="language-card">
      <a class="brand" href="/en/"><span class="brand-mark" aria-hidden="true">U</span><span>Utilark</span></a>
      <h1>404</h1>
      <p>Page not found · 페이지를 찾을 수 없습니다.</p>
      <div class="language-options">
        <a href="/en/">English home</a>
        <a href="/ko/" lang="ko">한국어 홈</a>
      </div>
    </main>
  </body>
</html>
