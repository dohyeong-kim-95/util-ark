---
import '../styles/global.css';
import { otherLocale, switchLocalePath, ui, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  title: string;
  /** Complete <title> including the brand, for pages that target a search query. */
  titleTag?: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const { locale, title, titleTag, description, noindex = false, schema } = Astro.props;
const t = ui[locale];
const site = Astro.site ?? new URL('https://utilark.app');
const canonicalUrl = new URL(Astro.url.pathname, site);
const alternateLocale = otherLocale(locale);
const alternatePath = switchLocalePath(Astro.url.pathname, locale);
const alternateUrl = new URL(alternatePath, site);
const englishPath = locale === 'en' ? Astro.url.pathname : alternatePath;
const xDefaultUrl = new URL(englishPath, site);
const fullTitle = titleTag ?? (title === 'Utilark' ? title : `${title} · Utilark`);
const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT?.trim();
// Naver verifies ownership by looking for this tag. It goes on every page
// because the site root answers with a redirect, so the verifier may well be
// reading a localized page instead of `/`.
const naverVerification = import.meta.env.PUBLIC_NAVER_SITE_VERIFICATION?.trim();
const showVisitorStats = Astro.url.pathname === `/${locale}/`;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Utilark',
    url: new URL(`/${locale}/`, site).href,
    inLanguage: locale,
    description: t.brandTagline,
    isAccessibleForFree: true,
    // A site with the same name exists on another domain, so state which
    // Utilark this is. The public source repository is the one reference that
    // cannot be copied by a lookalike, and it is what separates a tool site
    // from something wearing its name.
    sameAs: ['https://github.com/dohyeong-kim-95/util-ark'],
  },
  ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111319" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl.href} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl.href} />
    <link rel="alternate" hreflang={alternateLocale} href={alternateUrl.href} />
    <link rel="alternate" hreflang="x-default" href={xDefaultUrl.href} />
    {naverVerification && <meta name="naver-site-verification" content={naverVerification} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Utilark" />
    <meta property="og:locale" content={locale === 'ko' ? 'ko_KR' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl.href} />
    <meta name="twitter:card" content="summary" />

    {schemas.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}

    {adsenseClient && (
      <script
        is:inline
        async
        crossorigin="anonymous"
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
      ></script>
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={`/${locale}/`} aria-label="Utilark home">
          <span class="brand-mark" aria-hidden="true">U</span>
          <span>Utilark</span>
        </a>
        <nav class="primary-nav" aria-label="Primary navigation">
          <a href={`/${locale}/#tools`}>{t.nav.tools}</a>
          <a href={`/${locale}/guides/`}>{t.nav.guides}</a>
          <a href={`/${locale}/about/`}>{t.nav.about}</a>
          <a href={`/${locale}/privacy/`}>{t.nav.privacy}</a>
          <a
            class="language-link"
            href={alternatePath}
            hreflang={alternateLocale}
            lang={alternateLocale}
            data-language={alternateLocale}
          >
            {t.common.language}
          </a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href={`/${locale}/`}>
            <span class="brand-mark" aria-hidden="true">U</span>
            <span>Utilark</span>
          </a>
          <p>{t.footer.note}</p>
        </div>
        <nav aria-label="Footer navigation">
          <a href={`/${locale}/guides/`}>{t.nav.guides}</a>
          <a href={`/${locale}/about/`}>{t.nav.about}</a>
          <a href={`/${locale}/privacy/`}>{t.nav.privacy}</a>
          <a href={`/${locale}/terms/`}>{t.footer.terms}</a>
          <a href={`/${locale}/contact/`}>{t.nav.contact}</a>
          <a href="https://github.com/dohyeong-kim-95/util-ark" rel="noopener noreferrer">
            {t.footer.source}
          </a>
        </nav>
      </div>
      <div class="shell footer-bottom">© {new Date().getFullYear()} Utilark</div>
      {showVisitorStats && (
        <div class="shell visitor-stats" data-visitor-stats>
          <span>TODAY <strong data-period="today">–</strong></span>
          <span>WEEK <strong data-period="week">–</strong></span>
          <span>MONTH <strong data-period="month">–</strong></span>
          <small>
            {locale === 'ko'
              ? '개인 식별 정보 없이 당일 중복을 제외한 방문 합계입니다. 주·월 수치는 일별 방문 수의 합입니다.'
              : 'Privacy-preserving visit totals deduplicated per day. Week and month sum the daily counts.'}
            {' '}<a href={`/${locale}/privacy/`}>{t.nav.privacy}</a>
          </small>
        </div>
      )}
    </footer>

    <script>
      document.querySelectorAll<HTMLAnchorElement>('[data-language]').forEach((link) => {
        link.addEventListener('click', () => {
          const language = link.dataset.language;
          if (!language) return;
          localStorage.setItem('utilark-language', language);
          const secure = location.protocol === 'https:' ? '; Secure' : '';
          // Scoped to the whole domain so the short tool addresses open in the chosen language.
          const scope = /(^|\.)utilark\.app$/.test(location.hostname) ? '; Domain=utilark.app' : '';
          // Drop an earlier host-only cookie first, or both would be sent with conflicting values.
          document.cookie = `utilark_lang=; Path=/; Max-Age=0; SameSite=Lax${secure}`;
          document.cookie = `utilark_lang=${language}; Path=/; Max-Age=31536000; SameSite=Lax${scope}${secure}`;
        });
      });

      // A page view counts every browser that fetched the HTML, which includes
      // whatever ran it and left. A visit "qualifies" once the page has been
      // visible for three seconds or the visitor has touched it — the same rule
      // Bubblelab uses to separate people from fetchers. The beacon fires once
      // and carries no body; the server derives the same day-scoped key it
      // already uses for the page view, so nothing new is stored about anyone.
      {
        const QUALIFY_MS = 3000;
        const INTERACTIONS = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'];
        let timer = 0;
        let visibleFor = 0;
        let since: number | null = null;

        const qualify = () => {
          window.clearTimeout(timer);
          INTERACTIONS.forEach((type) => window.removeEventListener(type, qualify));
          document.removeEventListener('visibilitychange', onVisibility);
          const url = '/api/analytics/qualify';
          if (navigator.sendBeacon) {
            navigator.sendBeacon(url, new Blob(['{}'], { type: 'application/json' }));
            return;
          }
          fetch(url, { method: 'POST', keepalive: true }).catch(() => {});
        };
        const start = () => {
          if (since !== null) return;
          since = performance.now();
          timer = window.setTimeout(qualify, Math.max(0, QUALIFY_MS - visibleFor));
        };
        // Time spent on a hidden tab is not time spent reading, so the clock
        // pauses rather than running out in a background tab.
        const pause = () => {
          if (since === null) return;
          visibleFor += performance.now() - since;
          since = null;
          window.clearTimeout(timer);
        };
        function onVisibility() {
          if (document.hidden) pause();
          else start();
        }

        INTERACTIONS.forEach((type) => window.addEventListener(type, qualify, { passive: true }));
        document.addEventListener('visibilitychange', onVisibility);
        if (!document.hidden) start();
      }

      const visitorStats = document.querySelector<HTMLElement>('[data-visitor-stats]');
      if (visitorStats) {
        fetch('/api/analytics/public', { cache: 'no-store' })
          .then((response) => response.ok ? response.json() : Promise.reject())
          .then((data) => {
            for (const period of ['today', 'week', 'month']) {
              const value = visitorStats.querySelector<HTMLElement>(`[data-period="${period}"]`);
              if (value) value.textContent = Number(data[period] || 0).toLocaleString(document.documentElement.lang);
            }
          })
          .catch(() => visitorStats.remove());
      }
    </script>
  </body>
</html>
