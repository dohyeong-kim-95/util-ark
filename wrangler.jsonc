{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "utilark",
  "compatibility_date": "2026-08-12",
  "main": "./worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "vars": {
    "ADMIN_ID": "admin"
  },
  "secrets": {
    "required": ["ADMIN_PASSWORD", "ADMIN_SESSION_SECRET"]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACTS",
        "class_name": "ContactStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ContactStore"]
    }
  ]
}
